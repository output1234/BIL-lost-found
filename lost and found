<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Бюро находок</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@500&family=Playfair+Display:wght@600;700&display=swap');

  :root{
    --bg:#FAF7EF;
    --surface:#FFFFFF;
    --ink:#1C1B19;
    --ink-muted:#6B6862;
    --line:#E7E1D2;
    --green:#147A4B;
    --green-bg:#E6F4EC;
    --green-line:#BFE6D0;
    --red:#C63D2F;
    --red-bg:#FBEAE7;
    --red-line:#F2C9C1;
    --sand:#F1ECDD;
    --navy:#122A52;
    --navy-deep:#0B1B36;
    --gold:#C9A227;
    --gold-light:#F3E1A8;
  }

  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}

  body{
    font-family:'Inter', sans-serif;
    color:var(--ink);
    min-height:100vh;
    background:
      radial-gradient(680px 520px at 98% -12%, rgba(18,42,82,0.24), transparent 62%),
      radial-gradient(600px 460px at -10% 8%, rgba(201,162,39,0.26), transparent 58%),
      radial-gradient(560px 460px at 100% 55%, rgba(18,42,82,0.14), transparent 55%),
      radial-gradient(520px 420px at 6% 100%, rgba(201,162,39,0.16), transparent 55%),
      radial-gradient(1000px 760px at 50% 115%, rgba(18,42,82,0.08), transparent 60%),
      var(--bg);
    background-attachment:fixed;
    position:relative;
  }

  body::before{
    content:"";
    position:fixed;
    inset:0;
    pointer-events:none;
    background-image: radial-gradient(rgba(28,27,25,0.05) 1px, transparent 1.4px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 80% 65% at 50% 0%, #000 40%, transparent 90%);
    -webkit-mask-image: radial-gradient(ellipse 80% 65% at 50% 0%, #000 40%, transparent 90%);
    opacity:0.55;
  }

  .wrap{max-width:1180px;margin:0 auto;padding:36px 20px 70px;position:relative;}

  h1,h2,h3{font-family:'Space Grotesk', sans-serif;margin:0;}

  .top-row{display:flex;flex-wrap:wrap;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:24px;}

  .hero{
    position:relative;overflow:hidden;
    border-radius:20px;padding:28px 26px 24px;margin-bottom:24px;
    background:linear-gradient(120deg, #EAF0FA 0%, #F6F1E1 55%, #EDF2FA 100%);
    border:1px solid #DCE3F0;border-top:3px solid var(--gold);
  }
  .hero::before, .hero::after{
    content:"";position:absolute;border-radius:50%;pointer-events:none;
  }
  .hero::before{width:220px;height:220px;border:2px solid var(--gold);opacity:0.35;top:-90px;right:-60px;}
  .hero::after{width:120px;height:120px;background:var(--navy);opacity:0.06;bottom:-50px;left:-30px;}
  .hero .top-row{position:relative;margin-bottom:0;}
  .hero .brand h1{color:var(--navy-deep);font-family:'Playfair Display', serif;}
  .hero .brand p{color:var(--ink-muted);}
  .brand h1{font-size:30px;font-weight:700;}
  .brand p{font-size:14.5px;color:var(--ink-muted);margin-top:6px;max-width:440px;}

  .add-btn{
    display:flex;align-items:center;gap:8px;
    font-family:'Space Grotesk', sans-serif;font-weight:700;font-size:14.5px;
    color:var(--navy-deep);background:linear-gradient(135deg,#E8C766,var(--gold));border:none;border-radius:12px;
    padding:12px 18px;cursor:pointer;box-shadow:0 8px 20px rgba(201,162,39,0.35);
    transition:transform 150ms ease, box-shadow 150ms ease;
  }
  .add-btn:hover{transform:translateY(-1px);box-shadow:0 10px 24px rgba(201,162,39,0.45);}

  .stats{display:flex;gap:22px;flex-wrap:wrap;margin-bottom:22px;}
  .stat{display:flex;align-items:center;gap:8px;}
  .dot{width:9px;height:9px;border-radius:50%;display:inline-block;}
  .stat b{font-family:'Space Grotesk', sans-serif;font-weight:700;font-size:16px;}
  .stat span.label{font-size:13px;color:var(--ink-muted);}

  .search-box{position:relative;margin-bottom:16px;}
  .search-box svg{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#A8A399;}
  .search-box input{
    width:100%;font-size:14.5px;font-family:'Inter', sans-serif;
    padding:13px 14px 13px 40px;border-radius:12px;border:1px solid var(--line);
    outline:none;background:var(--surface);color:var(--ink);
  }
  .search-box input:focus{border-color:#A8A399;}

  .filters{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:26px;}
  .pill-group{display:flex;gap:6px;background:var(--sand);padding:4px;border-radius:12px;}
  .pill{
    border:none;border-radius:9px;padding:8px 14px;font-size:13.5px;font-weight:600;
    cursor:pointer;background:transparent;color:var(--ink-muted);
    font-family:'Inter', sans-serif;transition:background 150ms ease,color 150ms ease;
  }
  .pill.active{background:var(--navy);color:#FDFDFB;}
  .pill .count{opacity:0.65;font-weight:500;}

  select.cat-select{
    font-family:'Inter', sans-serif;font-size:14px;color:var(--ink);background:var(--surface);
    border:1px solid #E0DDD4;border-radius:12px;padding:9px 12px;cursor:pointer;outline:none;
  }

  .grid{display:grid;grid-template-columns:repeat(auto-fill, minmax(270px,1fr));gap:18px;}

  .card{
    background:var(--surface);border:1px solid var(--line);border-radius:18px;overflow:hidden;
    display:flex;flex-direction:column;transition:transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }
  .card:hover{transform:translateY(-3px);box-shadow:0 14px 30px rgba(28,27,25,0.08);border-color:#D8D4CB;}

  .card-accent{height:5px;width:100%;}

  .card-photo{position:relative;aspect-ratio:4/3;background:var(--sand);}
  .card-photo img{width:100%;height:100%;object-fit:cover;display:block;}
  .placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;
    background:linear-gradient(135deg,#F1EFE9,#E7E4DD);color:#A8A399;}

  .badge-id{
    position:absolute;top:10px;left:10px;font-family:'IBM Plex Mono',monospace;font-size:11px;
    letter-spacing:0.5px;background:rgba(28,27,25,0.55);color:#FDFDFB;padding:3px 8px;border-radius:999px;
  }
  .badge-status{
    position:absolute;top:10px;right:10px;display:flex;align-items:center;gap:6px;padding:5px 10px;
    border-radius:999px;font-size:12.5px;font-weight:600;
  }
  .badge-status.lost{background:var(--red-bg);color:var(--red);border:1px solid var(--red-line);}
  .badge-status.found{background:var(--green-bg);color:var(--green);border:1px solid var(--green-line);}

  .stamp{
    position:absolute;bottom:10px;right:-6px;transform:rotate(-10deg);display:flex;align-items:center;
    background:rgba(20,122,75,0.94);color:#FDFDFB;padding:6px 14px 6px 10px;border-radius:10px;
    box-shadow:0 6px 16px rgba(20,122,75,0.35);
  }

  .perforation{height:0;border-top:1.5px dashed #DEDAD1;position:relative;margin:0 14px;}
  .perforation::before,.perforation::after{
    content:"";position:absolute;top:-6px;width:12px;height:12px;border-radius:50%;
    background:var(--bg);border:1px solid var(--line);
  }
  .perforation::before{left:-20px;}
  .perforation::after{right:-20px;}

  .card-body{padding:16px 18px 18px;display:flex;flex-direction:column;gap:10px;flex:1;}
  .card-body h3{font-size:17px;font-weight:600;line-height:1.25;}
  .meta{display:flex;flex-direction:column;gap:5px;font-size:13.5px;color:var(--ink-muted);}
  .meta span{display:flex;align-items:center;gap:6px;}
  .meta span.ttl{color:var(--green);font-size:12px;font-weight:500;}
  .desc{font-size:13.5px;color:#413F3B;margin:0;line-height:1.5;display:-webkit-box;
    -webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}

  .card-footer{margin-top:auto;padding-top:6px;display:flex;align-items:center;justify-content:space-between;gap:10px;}
  .cat-tag{font-size:11px;font-weight:600;font-family:'Inter', sans-serif;padding:3px 10px;border-radius:999px;letter-spacing:0.2px;}

  .mark-btn{
    font-family:'Space Grotesk', sans-serif;font-size:12.5px;font-weight:600;color:var(--green);
    background:var(--green-bg);border:1px solid var(--green-line);border-radius:10px;padding:8px 12px;
    cursor:pointer;white-space:nowrap;transition:background 150ms ease;
  }
  .mark-btn:hover{background:#D9F0E3;}
  .mark-btn:active{transform:scale(0.97);}

  @keyframes pop{0%{transform:scale(1);}35%{transform:scale(1.03);}100%{transform:scale(1);}}
  .just-found{animation:pop 480ms ease;}

  .empty{text-align:center;padding:60px 20px;color:#A8A399;}

  .overlay{position:fixed;inset:0;background:rgba(28,27,25,0.45);display:flex;align-items:center;
    justify-content:center;padding:16px;z-index:50;}
  .modal{background:#FDFDFB;border-radius:20px;width:100%;max-width:460px;max-height:88vh;
    overflow-y:auto;border:1px solid var(--line);}
  .modal-head{display:flex;align-items:center;justify-content:space-between;padding:18px 20px 0;}
  .modal-head h2{font-size:19px;font-weight:600;}
  .close-btn{border:none;background:var(--sand);border-radius:999px;width:30px;height:30px;
    display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--ink-muted);}
  .modal-body{padding:20px;display:flex;flex-direction:column;gap:14px;}

  .photo-drop{
    display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;height:140px;
    border-radius:14px;border:1.5px dashed #D8D4CB;background:#F7F5F0;cursor:pointer;overflow:hidden;
    color:#A8A399;position:relative;
  }
  .photo-drop img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0;display:none;}

  .field{display:flex;flex-direction:column;gap:6px;}
  .field span{font-size:12.5px;color:var(--ink-muted);font-weight:500;}
  .field input, .field select, .field textarea{
    font-family:'Inter', sans-serif;font-size:14px;color:var(--ink);background:#FFFFFF;
    border:1px solid #E0DDD4;border-radius:10px;padding:10px 12px;outline:none;width:100%;
  }
  .field input:focus, .field select:focus, .field textarea:focus{border-color:#A8A399;}
  .row-2{display:flex;gap:12px;}
  .row-2 > *{flex:1;}

  .submit-btn{
    margin-top:4px;font-family:'Space Grotesk', sans-serif;font-weight:600;font-size:14.5px;color:#FDFDFB;
    background:var(--navy);border:none;border-radius:12px;padding:13px 16px;cursor:pointer;
  }
  .submit-btn:disabled{background:#C9C6BE;cursor:not-allowed;}

  .footer-note{text-align:center;font-size:12.5px;color:#A8A399;margin-top:34px;}

  .crest-bar{
    background:linear-gradient(90deg, var(--navy-deep), var(--navy));
    color:var(--gold-light);border-bottom:2px solid var(--gold);
    display:flex;align-items:center;justify-content:center;gap:10px;
    padding:9px 16px;font-family:'Space Grotesk', sans-serif;font-size:12.5px;
    font-weight:600;letter-spacing:1.2px;text-transform:uppercase;text-align:center;
  }
  .crest-bar svg{color:var(--gold);flex-shrink:0;}

  .nav-bar{max-width:1180px;margin:0 auto;padding:18px 20px 0;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;}
  .nav-tabs{display:flex;gap:8px;}
  .nav-right{display:flex;align-items:center;gap:10px;}
  .nav-tab{
    font-family:'Space Grotesk', sans-serif;font-weight:600;font-size:14px;
    padding:10px 16px;border-radius:11px;border:1px solid var(--navy);cursor:pointer;
    background:transparent;color:var(--navy);transition:background 150ms ease,color 150ms ease;
  }
  .nav-tab:hover{background:var(--sand);}
  .nav-tab.active{background:var(--navy);color:var(--gold-light);border-color:var(--navy);}

  .whoami{font-size:13px;color:var(--ink-muted);display:flex;align-items:center;gap:7px;}
  .role-badge{font-size:10px;font-weight:700;padding:3px 8px;border-radius:999px;text-transform:uppercase;letter-spacing:0.3px;white-space:nowrap;}
  .role-badge.admin{background:var(--gold-light);color:#7A5A00;}
  .role-badge.participant{background:var(--sand);color:var(--navy);}

  .users-toggle{border:1px solid var(--line);background:var(--surface);border-radius:10px;padding:8px 12px;font-size:13px;cursor:pointer;color:var(--ink-muted);font-family:'Inter', sans-serif;}
  .users-toggle:hover{background:var(--sand);}
  .users-panel{max-width:1180px;margin:8px auto 0;padding:0 20px;}
  .users-panel .inner{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:10px;display:flex;flex-direction:column;gap:4px;max-height:280px;overflow-y:auto;}
  .user-row{display:flex;align-items:center;gap:10px;padding:7px 8px;border-radius:8px;font-size:13px;}
  .user-row:hover{background:var(--sand);}
  .user-name{font-weight:600;white-space:nowrap;}
  .user-meta{color:var(--ink-muted);font-size:12px;flex:1;}
  .promote-btn{border:none;background:var(--navy);color:#FDFDFB;border-radius:8px;padding:6px 10px;font-size:11.5px;cursor:pointer;white-space:nowrap;}
  .promote-btn:hover{background:#2c2a26;}
  .users-empty{font-size:13px;color:#A8A399;padding:6px 8px;}

  .role-toggle-btn{flex:1;padding:9px;border-radius:10px;border:1px solid #E0DDD4;background:#FFFFFF;cursor:pointer;font-size:13px;font-weight:600;color:var(--ink-muted);font-family:'Inter', sans-serif;}
  .role-toggle-btn.active{background:var(--navy);color:#FDFDFB;border-color:var(--navy);}

  .notice{
    position:fixed;left:50%;bottom:24px;transform:translate(-50%,20px);background:var(--ink);color:#FDFDFB;
    padding:11px 20px;border-radius:999px;font-size:13px;opacity:0;pointer-events:none;
    transition:opacity 200ms ease, transform 200ms ease;z-index:200;white-space:nowrap;
  }
  .notice.show{opacity:1;transform:translate(-50%,0);}

  .admin-hint{font-size:12px;color:#A8A399;}

  .leader-list{display:flex;flex-direction:column;gap:8px;margin-bottom:8px;}
  .leader-row{
    display:flex;align-items:center;gap:14px;background:var(--surface);border:1px solid var(--line);
    border-radius:14px;padding:12px 16px;transition:transform 150ms ease, box-shadow 150ms ease;
  }
  .leader-row:hover{transform:translateY(-2px);box-shadow:0 10px 22px rgba(28,27,25,0.06);}
  .leader-rank{
    font-family:'Space Grotesk', sans-serif;font-weight:700;font-size:14px;width:30px;height:30px;
    display:flex;align-items:center;justify-content:center;border-radius:50%;color:var(--ink-muted);background:var(--sand);flex-shrink:0;
  }
  .leader-rank.top1,.leader-rank.top2,.leader-rank.top3{font-size:17px;background:transparent;}
  .leader-row.top1{background:linear-gradient(90deg, #FFF6DF, var(--surface) 55%);border-color:#F3E0A8;}
  .leader-row.top2{background:linear-gradient(90deg, #F2F2F5, var(--surface) 55%);border-color:#DADADF;}
  .leader-row.top3{background:linear-gradient(90deg, #FBEADF, var(--surface) 55%);border-color:#EBCBA9;}
  .leader-name{flex:1;font-family:'Space Grotesk', sans-serif;font-weight:600;font-size:15px;}
  .leader-points{font-family:'Space Grotesk', sans-serif;font-weight:700;color:var(--green);font-size:15.5px;}

  .classes-grid{display:grid;grid-template-columns:repeat(auto-fill, minmax(280px,1fr));gap:18px;}
  .class-card{
    background:var(--surface);border:1px solid var(--line);border-left-width:4px;border-radius:18px;padding:18px;
    display:flex;flex-direction:column;gap:12px;transition:transform 180ms ease, box-shadow 180ms ease;
  }
  .class-card:hover{transform:translateY(-3px);box-shadow:0 14px 30px rgba(28,27,25,0.08);}
  .class-card-head{display:flex;align-items:center;justify-content:space-between;}
  .class-points{font-family:'Space Grotesk', sans-serif;font-weight:700;font-size:22px;color:var(--green);}

  .aktiv-list{display:flex;flex-wrap:wrap;gap:6px;}
  .aktiv-chip{display:flex;align-items:center;gap:6px;background:var(--sand);border-radius:999px;padding:5px 10px;font-size:12.5px;}
  .aktiv-chip .role{color:var(--ink-muted);}
  .aktiv-chip button{border:none;background:none;cursor:pointer;color:#A8A399;font-size:11px;padding:0;line-height:1;}
  .aktiv-chip button:hover{color:var(--red);}

  .aktiv-add-row{display:flex;gap:6px;}
  .aktiv-add-row input{flex:1;font-size:12.5px;padding:7px 9px;border-radius:8px;border:1px solid #E0DDD4;outline:none;font-family:'Inter', sans-serif;}
  .aktiv-add-row input:focus{border-color:#A8A399;}
  .aktiv-add-row button{border:none;background:var(--ink);color:#FDFDFB;border-radius:8px;padding:0 12px;cursor:pointer;font-size:14px;}

  .action-row{display:flex;flex-wrap:wrap;gap:6px;}
  .action-btn{
    border:1px solid transparent;border-radius:999px;padding:6px 10px;
    font-size:11.5px;font-weight:600;cursor:pointer;font-family:'Inter', sans-serif;
    transition:transform 120ms ease, box-shadow 150ms ease;
  }
  .action-btn:hover{transform:translateY(-1px);}
  .action-btn.positive{background:var(--green-bg);color:var(--green);border-color:var(--green-line);}
  .action-btn.negative{background:var(--red-bg);color:var(--red);border-color:var(--red-line);}
  .action-btn.positive:hover{box-shadow:0 6px 14px rgba(20,122,75,0.18);}
  .action-btn.negative:hover{box-shadow:0 6px 14px rgba(198,61,47,0.18);}

  .last-action{font-size:11.5px;color:#A8A399;font-family:'IBM Plex Mono',monospace;}

  @media (prefers-reduced-motion: reduce){
    .card,.mark-btn,.just-found,.add-btn,.class-card,.leader-row,.notice{transition:none !important;animation:none !important;}
  }
</style>
</head>
<body>
  <div class="crest-bar">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2l8 3v6c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5l8-3z"/><path d="M12 8l1.2 2.4 2.6.4-1.9 1.9.5 2.6L12 14l-2.4 1.3.5-2.6-1.9-1.9 2.6-.4L12 8z"/></svg>
    Ақтөбе Білім-Инновация Лицейі · БИЛ
  </div>

  <div id="auth-gate" class="overlay" style="display:none;z-index:100;">
    <div class="modal" style="max-width:420px;">
      <div class="modal-head"><h2>Представьтесь</h2></div>
      <div class="modal-body">
        <p style="font-size:13px;color:var(--ink-muted);margin:0;">Чтобы попасть на сайт, укажите, кто вы — это будут видеть остальные.</p>
        <div class="field"><span>Имя</span><input id="reg-firstname" oninput="updateRegisterState()" placeholder="Имя" /></div>
        <div class="field"><span>Фамилия</span><input id="reg-lastname" oninput="updateRegisterState()" placeholder="Фамилия" /></div>
        <div class="field">
          <span>Кто вы?</span>
          <div style="display:flex;gap:8px;">
            <button type="button" id="role-student-btn" class="role-toggle-btn active" onclick="selectRegKind('student')">Ученик</button>
            <button type="button" id="role-teacher-btn" class="role-toggle-btn" onclick="selectRegKind('teacher')">Учитель</button>
          </div>
        </div>
        <input type="hidden" id="reg-kind" value="student" />
        <div class="field" id="reg-class-field">
          <span>Класс</span>
          <select id="reg-class" onchange="updateRegisterState()">
            <option value="">Выберите класс</option>
            <option value="7А">7А</option><option value="7Б">7Б</option>
            <option value="8А">8А</option><option value="8Б">8Б</option>
            <option value="9А">9А</option><option value="9Б">9Б</option>
            <option value="10А">10А</option><option value="10Б">10Б</option>
            <option value="11А">11А</option><option value="11Б">11Б</option>
          </select>
        </div>
        <button class="submit-btn" id="reg-submit" disabled onclick="submitRegistration()">Войти на сайт</button>
      </div>
    </div>
  </div>

  <div class="nav-bar">
    <div class="nav-tabs">
      <button class="nav-tab active" id="nav-lostfound" onclick="showPage('lostfound')">Бюро находок</button>
      <button class="nav-tab" id="nav-classes" onclick="showPage('classes')">Доска почёта</button>
    </div>
    <div class="nav-right">
      <button class="users-toggle" onclick="toggleUsersPanel()">👥 Участники</button>
      <span id="whoami" class="whoami"></span>
    </div>
  </div>

  <div id="users-panel" class="users-panel" style="display:none">
    <div class="inner" id="users-list"></div>
  </div>

  <div id="page-lostfound" class="page">
  <div class="wrap">
    <div class="hero">
    <div class="top-row">
      <div class="brand">
        <h1>Бюро находок</h1>
        <p>Быстро узнайте, что потеряно, а что уже нашлось.</p>
      </div>
      <button class="add-btn" onclick="openModal()">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Добавить вещь
      </button>
    </div>
    </div>

    <div class="stats" id="stats"></div>

    <div class="search-box">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input id="search-input" placeholder="Поиск по названию, месту или описанию..." oninput="onSearch(this.value)" />
    </div>

    <div class="filters" id="filters"></div>

    <div class="grid" id="grid"></div>

    <p class="footer-note">Данные этой страницы общие: их видят и могут дополнять все, у кого есть ссылка. Найденные вещи автоматически исчезают из списка через час.</p>
  </div>
  </div>

  <div id="page-classes" class="page" style="display:none">
    <div class="wrap">
      <div class="hero">
      <div class="top-row">
        <div class="brand">
          <h1>Доска почёта</h1>
          <p>Балл начисляется автоматически каждому, кто подаёт заявление о потерянной вещи.</p>
        </div>
      </div>
      </div>

      <h2 style="font-size:16px;font-weight:600;margin-bottom:12px;">Рейтинг участников</h2>
      <div class="leader-list" id="leaderboard"></div>

      <p class="footer-note">1 заявление о потерянной вещи = 1 балл. Баллы не пропадают, даже если вещь потом найдётся. Данные общие для всех, у кого есть ссылка.</p>
    </div>
  </div>

  <div id="modal-root"></div>
  <div id="notice" class="notice"></div>

<script>
  const CATEGORIES = ["Электроника","Документы","Ключи","Одежда","Аксессуары","Другое"];

  const CATEGORY_COLORS = {
    "Электроника": { bg:"#E7ECF5", fg:"#1F3A66" },
    "Документы": { bg:"#F3E9EC", fg:"#7A2E3A" },
    "Ключи": { bg:"#F7EFD9", fg:"#8A6A1E" },
    "Одежда": { bg:"#EDE7F5", fg:"#5B3E8E" },
    "Аксессуары": { bg:"#E3F0EF", fg:"#1F6F78" },
    "Другое": { bg:"#EDEBE6", fg:"#4B4640" }
  };
  function categoryColor(cat){ return CATEGORY_COLORS[cat] || { bg:"#EDEBE6", fg:"#4B4640" }; }

  function hashColor(str){
    let hash = 0;
    for (let i = 0; i < str.length; i++){ hash = str.charCodeAt(i) + ((hash << 5) - hash); }
    const hue = Math.abs(hash) % 360;
    return { bg: `hsl(${hue},38%,92%)`, fg: `hsl(${hue},40%,30%)`, solid: `hsl(${hue},34%,42%)` };
  }

  function avatarHTML(name, size){
    size = size || 26;
    const c = hashColor(name);
    const initials = name.trim().split(/\s+/).map(p => p[0]).slice(0, 2).join('').toUpperCase();
    return `<span style="display:inline-flex;align-items:center;justify-content:center;width:${size}px;height:${size}px;border-radius:50%;background:${c.solid};color:#fff;font-size:${Math.round(size*0.42)}px;font-weight:700;font-family:'Space Grotesk',sans-serif;flex-shrink:0;">${esc(initials)}</span>`;
  }

  const SEED_ITEMS = [
    {id:"00042", title:"Чёрный рюкзак Nike", description:"Городской рюкзак с двумя молниями и красной нашивкой сбоку. Внутри учебник по физике.", location:"ст. м. Спортивная", date:"2026-08-28", category:"Аксессуары", status:"lost", photo:"https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=600&q=60&auto=format&fit=crop"},
    {id:"00041", title:"Связка ключей с брелоком-совой", description:"Три ключа и брелок в виде совы. Потеряны у входа в парк.", location:"Парк Горького", date:"2026-08-30", category:"Ключи", status:"lost", photo:"https://images.unsplash.com/photo-1582139329536-e7284fece509?w=600&q=60&auto=format&fit=crop"},
    {id:"00039", title:"Айфон в синем чехле", description:"Экран немного треснут в углу. На чехле наклейка с цветком.", location:"Кофейня «Зёрна»", date:"2026-08-25", category:"Электроника", status:"found", foundAt: Date.now(), photo:"https://images.unsplash.com/photo-1512499617640-c74ae3a79d37?w=600&q=60&auto=format&fit=crop"},
    {id:"00037", title:"Полосатый кот", description:"Рыжий с белым, в ошейнике без бирки. Очень ласковый, отзывается на «Барсик».", location:"ул. Абая, двор 14", date:"2026-08-22", category:"Другое", status:"found", foundAt: Date.now(), photo:"https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?w=600&q=60&auto=format&fit=crop"},
    {id:"00035", title:"Зонт-трость коричневый", description:"Деревянная ручка, забыт в вагоне метро в районе полудня.", location:"Линия 1, вагон №3", date:"2026-08-20", category:"Другое", status:"lost", photo:"https://images.unsplash.com/photo-1534088568595-a066f410bcda?w=600&q=60&auto=format&fit=crop"},
    {id:"00031", title:"Паспорт на имя А. Серикова", description:"Найден в бумажном конверте рядом со скамейкой у входа.", location:"Центральная площадь", date:"2026-08-18", category:"Документы", status:"found", foundAt: Date.now(), photo:"https://images.unsplash.com/photo-1568084680786-a84f91d1153c?w=600&q=60&auto=format&fit=crop"}
  ];

  let state = {
    items: [],
    query: "",
    statusFilter: "all",
    categoryFilter: "all",
    justFoundId: null
  };
  let draftPhoto = null;

  // ================= Аккаунты и роли =================
  let currentUser = null;
  let usersCache = [];

  async function loadMyProfile(){
    if (window.storage){
      try{
        const res = await window.storage.get('myProfile', false);
        if (res && res.value) return JSON.parse(res.value);
      }catch(e){ /* ещё не регистрировался */ }
    }
    return null;
  }
  async function saveMyProfile(p){
    if (window.storage){
      try{ await window.storage.set('myProfile', JSON.stringify(p), false); }catch(e){}
    }
  }
  async function loadUsers(){
    if (window.storage){
      try{
        const res = await window.storage.get('siteUsers', true);
        if (res && res.value){ usersCache = JSON.parse(res.value); return usersCache; }
      }catch(e){ /* список пуст */ }
    }
    return usersCache;
  }
  async function saveUsers(list){
    usersCache = list;
    if (window.storage){
      try{ await window.storage.set('siteUsers', JSON.stringify(list), true); }catch(e){}
    }
  }

  function genUserId(){ return 'u-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8); }
  function isAdmin(){ return !!(currentUser && currentUser.role === 'admin'); }
  function roleLabel(u){ return u.role === 'admin' ? 'Админ' : 'Участник'; }

  function requireAdmin(actionText){
    if (!isAdmin()){
      showNotice((actionText || 'Это действие') + ' доступно только админу.');
      return false;
    }
    return true;
  }

  async function bootAuth(){
    const profile = await loadMyProfile();
    if (profile){
      currentUser = profile;
      if (typeof currentUser.points !== 'number') currentUser.points = 0;
      const users = await loadUsers();
      const match = users.find(u => u.id === currentUser.id);
      if (match){
        if (typeof match.points !== 'number') match.points = 0;
        if (match.role !== currentUser.role || match.points !== currentUser.points){
          currentUser.role = match.role;
          currentUser.points = match.points;
          saveMyProfile(currentUser);
        }
      } else {
        users.push(currentUser);
        saveUsers(users);
      }
      finishBoot();
    } else {
      showAuthGate();
    }
  }

  function showAuthGate(){
    document.getElementById('auth-gate').style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function selectRegKind(kind){
    document.getElementById('reg-kind').value = kind;
    document.getElementById('reg-class-field').style.display = kind === 'student' ? '' : 'none';
    document.getElementById('role-student-btn').classList.toggle('active', kind === 'student');
    document.getElementById('role-teacher-btn').classList.toggle('active', kind === 'teacher');
    updateRegisterState();
  }

  function updateRegisterState(){
    const fn = document.getElementById('reg-firstname').value.trim();
    const ln = document.getElementById('reg-lastname').value.trim();
    const kind = document.getElementById('reg-kind').value;
    const cls = document.getElementById('reg-class').value;
    const ok = fn && ln && (kind === 'teacher' || (kind === 'student' && cls));
    document.getElementById('reg-submit').disabled = !ok;
  }

  async function submitRegistration(){
    const firstName = document.getElementById('reg-firstname').value.trim();
    const lastName = document.getElementById('reg-lastname').value.trim();
    const kind = document.getElementById('reg-kind').value;
    const classOrRole = kind === 'teacher' ? 'Учитель' : document.getElementById('reg-class').value;
    if (!firstName || !lastName || (kind === 'student' && !classOrRole)) return;

    const users = await loadUsers();
    const role = users.length === 0 ? 'admin' : 'participant';
    const newUser = { id: genUserId(), firstName, lastName, classOrRole, isTeacher: kind === 'teacher', role, points: 0, registeredAt: Date.now() };
    users.push(newUser);
    await saveUsers(users);
    await saveMyProfile(newUser);
    currentUser = newUser;

    document.getElementById('auth-gate').style.display = 'none';
    document.body.style.overflow = '';
    finishBoot();
  }

  function finishBoot(){
    renderWhoAmI();
    renderUsersPanel();
    init();
    showPage(location.hash === '#classes' ? 'classes' : 'lostfound');
    setInterval(pollUsers, 6000);
  }

  function renderWhoAmI(){
    const fullName = `${currentUser.firstName} ${currentUser.lastName}`;
    document.getElementById('whoami').innerHTML =
      `${avatarHTML(fullName, 24)} ${esc(currentUser.firstName)} ${esc(currentUser.lastName)} · ${esc(currentUser.classOrRole)} · ${currentUser.points || 0} б. <span class="role-badge ${currentUser.role}">${roleLabel(currentUser)}</span>`;
  }

  function renderUsersPanel(){
    const listEl = document.getElementById('users-list');
    if (!listEl) return;
    if (usersCache.length === 0){
      listEl.innerHTML = `<div class="users-empty">Пока никого нет.</div>`;
      return;
    }
    listEl.innerHTML = usersCache.map(u => `
      <div class="user-row">
        ${avatarHTML(u.firstName + ' ' + u.lastName, 24)}
        <span class="user-name">${esc(u.firstName)} ${esc(u.lastName)}</span>
        <span class="user-meta">${esc(u.classOrRole)} · ${u.points || 0} б.</span>
        <span class="role-badge ${u.role}">${roleLabel(u)}</span>
        ${(isAdmin() && u.role !== 'admin') ? `<button class="promote-btn" onclick="promoteUser('${u.id}')">Сделать админом</button>` : ''}
      </div>
    `).join('');
  }

  function toggleUsersPanel(){
    const p = document.getElementById('users-panel');
    const opening = p.style.display === 'none';
    p.style.display = opening ? '' : 'none';
    if (opening){ loadUsers().then(renderUsersPanel); }
  }

  async function promoteUser(userId){
    if (!requireAdmin('Назначение админом')) return;
    const users = await loadUsers();
    const u = users.find(x => x.id === userId);
    if (!u) return;
    u.role = 'admin';
    await saveUsers(users);
    renderUsersPanel();
    showNotice(`${u.firstName} ${u.lastName} теперь админ.`);
  }

  async function pollUsers(){
    const users = await loadUsers();
    if (document.getElementById('users-panel').style.display !== 'none') renderUsersPanel();
    if (document.getElementById('page-classes').style.display !== 'none') renderParticipantsLeaderboard();
    const mine = users.find(u => currentUser && u.id === currentUser.id);
    if (mine && (mine.role !== currentUser.role || mine.points !== currentUser.points)){
      const roleChanged = mine.role !== currentUser.role;
      currentUser.role = mine.role;
      currentUser.points = mine.points;
      saveMyProfile(currentUser);
      renderWhoAmI();
      renderUsersPanel();
      renderAll();
      if (roleChanged) showNotice(mine.role === 'admin' ? 'Вас назначили админом.' : 'Ваша роль обновлена.');
    }
  }

  function showNotice(text){
    const n = document.getElementById('notice');
    n.textContent = text;
    n.classList.add('show');
    clearTimeout(showNotice._t);
    showNotice._t = setTimeout(() => n.classList.remove('show'), 2600);
  }

  // ================= Рейтинг участников =================
  const CLASS_NAMES = ["7А","7Б","8А","8Б","9А","9Б","10А","10Б","11А","11Б"];
  const CLASS_COLORS = ["#1F3A66","#8A6A1E","#7A2E3A","#5B3E8E","#1F6F78","#4B4640","#8A5A2B","#2E4A7A","#6B4226","#3C6E71"];
  function classColor(id){ const idx = CLASS_NAMES.indexOf(id); return idx === -1 ? "#4B4640" : CLASS_COLORS[idx % CLASS_COLORS.length]; }

  function renderParticipantsLeaderboard(){
    const el = document.getElementById('leaderboard');
    if (!el) return;
    const ranked = [...usersCache].sort((a, b) => (b.points || 0) - (a.points || 0));
    const medals = ["🥇", "🥈", "🥉"];
    if (ranked.length === 0){
      el.innerHTML = `<div class="users-empty">Пока никто не зарегистрирован.</div>`;
      return;
    }
    el.innerHTML = ranked.map((u, i) => {
      const tier = i < 3 ? 'top' + (i + 1) : '';
      const c = classColor(u.classOrRole);
      const rankStyle = i < 3 ? '' : `style="background:${c}22;color:${c};"`;
      const fullName = `${u.firstName} ${u.lastName}`;
      return `
      <div class="leader-row ${tier}">
        <span class="leader-rank ${tier}" ${rankStyle}>${i < 3 ? medals[i] : (i + 1)}</span>
        ${avatarHTML(fullName, 26)}
        <span class="leader-name">${esc(fullName)}</span>
        <span class="role-badge" style="background:${c}22;color:${c};">${esc(u.classOrRole)}</span>
        <span class="leader-points" style="color:${c}">${u.points || 0} б.</span>
      </div>
    `;
    }).join('');
  }

  // ---------- переключение страниц ----------
  function showPage(page){
    document.getElementById('page-lostfound').style.display = page === 'lostfound' ? '' : 'none';
    document.getElementById('page-classes').style.display = page === 'classes' ? '' : 'none';
    document.getElementById('nav-lostfound').classList.toggle('active', page === 'lostfound');
    document.getElementById('nav-classes').classList.toggle('active', page === 'classes');
    if (page === 'classes') renderParticipantsLeaderboard();
    location.hash = page;
  }

  // ---------- storage ----------
  async function loadItems(){
    if (window.storage){
      try{
        const res = await window.storage.get('items', true);
        if (res && res.value) return JSON.parse(res.value);
      }catch(e){ /* no data yet */ }
    }
    return null;
  }
  async function saveItems(items){
    if (window.storage){
      try{ await window.storage.set('items', JSON.stringify(items), true); }catch(e){}
    }
  }

  const FOUND_LIFETIME_MS = 60 * 60 * 1000; // 1 час

  async function init(){
    const loaded = await loadItems();
    if (loaded && loaded.length){
      state.items = loaded.map(it => (it.status === "found" && !it.foundAt) ? {...it, foundAt: Date.now()} : it);
    } else {
      state.items = SEED_ITEMS;
      saveItems(state.items);
    }
    cleanupExpired();
    renderAll();
    setInterval(pollForUpdates, 6000);
    setInterval(secondTick, 1000);
  }

  function secondTick(){
    let expired = false;
    state.items.forEach(it => {
      if (it.status !== "found" || !it.foundAt) return;
      const remainMs = it.foundAt + FOUND_LIFETIME_MS - Date.now();
      if (remainMs <= 0){
        expired = true;
        return;
      }
      const el = document.getElementById('ttl-' + it.id);
      if (el) el.textContent = formatCountdown(remainMs);
    });
    if (expired) cleanupExpired();
  }

  function cleanupExpired(){
    const cutoff = Date.now() - FOUND_LIFETIME_MS;
    const before = state.items.length;
    state.items = state.items.filter(it => !(it.status === "found" && it.foundAt && it.foundAt < cutoff));
    const changed = state.items.length !== before;
    if (changed){
      renderAll();
      saveItems(state.items);
    }
    return changed;
  }

  function formatCountdown(remainMs){
    const totalSec = Math.max(0, Math.ceil(remainMs / 1000));
    const m = Math.floor(totalSec / 60);
    const s = totalSec % 60;
    return `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
  }

  function formatRemaining(foundAt){
    if (!foundAt) return null;
    const remainMs = foundAt + FOUND_LIFETIME_MS - Date.now();
    if (remainMs <= 0) return null;
    return formatCountdown(remainMs);
  }

  async function pollForUpdates(){
    if (document.getElementById('modal-root').children.length) return; // don't disrupt while adding
    const loaded = await loadItems();
    if (!loaded) return;
    const withFallback = loaded.map(it => (it.status === "found" && !it.foundAt) ? {...it, foundAt: Date.now()} : it);
    if (JSON.stringify(withFallback) !== JSON.stringify(state.items)){
      state.items = withFallback;
      renderAll();
    }
    cleanupExpired();
  }

  // ---------- helpers ----------
  function esc(str){
    return String(str).replace(/[&<>"']/g, s => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[s]));
  }
  function formatDate(iso){
    const d = new Date(iso + "T00:00:00");
    if (isNaN(d)) return iso;
    return d.toLocaleDateString("ru-RU", { day:"numeric", month:"short", year:"numeric" });
  }
  function filteredItems(){
    const q = state.query.trim().toLowerCase();
    return state.items.filter(it => {
      if (state.statusFilter !== "all" && it.status !== state.statusFilter) return false;
      if (state.categoryFilter !== "all" && it.category !== state.categoryFilter) return false;
      if (q){
        const hay = (it.title + " " + it.description + " " + it.location).toLowerCase();
        if (!hay.includes(q)) return false;
      }
      return true;
    });
  }

  // ---------- render ----------
  function renderAll(){
    renderStats();
    renderFilters();
    renderGrid();
  }

  function renderStats(){
    const total = state.items.length;
    const found = state.items.filter(i => i.status === "found").length;
    const lost = total - found;
    document.getElementById('stats').innerHTML = `
      <div class="stat"><span class="dot" style="background:#1C1B19"></span><b>${total}</b><span class="label">Всего вещей</span></div>
      <div class="stat"><span class="dot" style="background:#C63D2F"></span><b>${lost}</b><span class="label">Не найдено</span></div>
      <div class="stat"><span class="dot" style="background:#147A4B"></span><b>${found}</b><span class="label">Найдено</span></div>
    `;
  }

  function renderFilters(){
    const total = state.items.length;
    const found = state.items.filter(i => i.status === "found").length;
    const lost = total - found;
    const tabs = [
      {key:"all", label:"Все", count:total},
      {key:"lost", label:"Не найдено", count:lost},
      {key:"found", label:"Найдено", count:found}
    ];
    const pills = tabs.map(t => `
      <button class="pill ${state.statusFilter===t.key?'active':''}" onclick="setStatusFilter('${t.key}')">
        ${t.label} <span class="count">· ${t.count}</span>
      </button>
    `).join('');

    const catOptions = CATEGORIES.map(c => `<option value="${esc(c)}" ${state.categoryFilter===c?'selected':''}>${esc(c)}</option>`).join('');

    document.getElementById('filters').innerHTML = `
      <div class="pill-group">${pills}</div>
      <select class="cat-select" onchange="setCategoryFilter(this.value)">
        <option value="all" ${state.categoryFilter==='all'?'selected':''}>Все категории</option>
        ${catOptions}
      </select>
    `;
  }

  function cardHTML(item){
    const isFound = item.status === "found";
    const catColor = categoryColor(item.category);
    const photoInner = item.photo
      ? `<img src="${esc(item.photo)}" alt="${esc(item.title)}" onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'placeholder',innerHTML:placeholderSVG}))" />`
      : `<div class="placeholder">${placeholderSVG}</div>`;

    return `
      <div class="card-accent" style="background:${catColor.fg}"></div>
      <div class="card-photo">
        ${photoInner}
        <div class="badge-id">№ ${esc(item.id)}</div>
        <div class="badge-status ${isFound?'found':'lost'}">${isFound ? '✓ Найдено' : '🔴 Не найдено'}</div>
        ${isFound ? `<div class="stamp">${checkSVG}</div>` : ''}
      </div>
      <div class="perforation"></div>
      <div class="card-body">
        <h3>${esc(item.title)}</h3>
        <div class="meta">
          <span>${pinSVG} ${esc(item.location)}</span>
          <span>${calSVG} ${formatDate(item.date)}</span>
          ${isFound && formatRemaining(item.foundAt) ? `<span class="ttl">${clockSVG} исчезнет через <span id="ttl-${esc(item.id)}">${formatRemaining(item.foundAt)}</span></span>` : ''}
          ${item.reportedBy ? `<span>${avatarHTML(item.reportedBy, 16)} добавил(а): ${esc(item.reportedBy)}</span>` : ''}
        </div>
        <p class="desc">${esc(item.description)}</p>
        <div class="card-footer">
          <span class="cat-tag" style="background:${catColor.bg};color:${catColor.fg};">${esc(item.category)}</span>
          ${(!isFound && isAdmin()) ? `<button class="mark-btn" onclick="markFound('${item.id}')">Отметить как найдено</button>` : ''}
        </div>
      </div>
    `;
  }

  function renderGrid(){
    const items = filteredItems();
    const grid = document.getElementById('grid');
    if (items.length === 0){
      grid.innerHTML = `<div class="empty" style="grid-column:1/-1">
        ${searchOffSVG}
        <p style="font-size:14.5px;margin:8px 0 0">Ничего не нашлось. Попробуйте изменить фильтры или запрос.</p>
      </div>`;
      return;
    }
    grid.innerHTML = items.map(it => `<div class="card ${state.justFoundId===it.id?'just-found':''}" id="card-${it.id}">${cardHTML(it)}</div>`).join('');
  }

  // ---------- icons (inline svg strings) ----------
  const pinSVG = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`;
  const calSVG = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`;
  const checkSVG = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`;
  const placeholderSVG = `<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>`;
  const searchOffSVG = `<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>`;
  const clockSVG = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15.5 14"/></svg>`;
  const personSVG = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`;

  // ---------- actions ----------
  function onSearch(v){ state.query = v; renderGrid(); }
  function setStatusFilter(key){ state.statusFilter = key; renderFilters(); renderGrid(); }
  function setCategoryFilter(v){ state.categoryFilter = v; renderGrid(); }

  async function markFound(id){
    if (!requireAdmin('Отметка "Найдено"')) return;
    state.items = state.items.map(it => it.id === id ? {...it, status:"found", foundAt: Date.now()} : it);
    state.justFoundId = id;
    renderAll();
    saveItems(state.items);
    setTimeout(() => { state.justFoundId = null; }, 900);
  }

  // ---------- modal ----------
  function openModal(){
    draftPhoto = null;
    const catOptions = CATEGORIES.map(c => `<option value="${esc(c)}">${esc(c)}</option>`).join('');
    const today = new Date().toISOString().slice(0,10);
    document.getElementById('modal-root').innerHTML = `
      <div class="overlay" onclick="if(event.target===this) closeModal()">
        <div class="modal">
          <div class="modal-head">
            <h2>Добавить вещь</h2>
            <button class="close-btn" onclick="closeModal()">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>
          <div class="modal-body">
            <label class="photo-drop" for="photo-input">
              <img id="photo-preview" />
              <span id="photo-placeholder" style="display:flex;flex-direction:column;align-items:center;gap:6px;">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 16l4.586-4.586a2 2 0 0 1 2.828 0L16 16"/><path d="M14 14l1.586-1.586a2 2 0 0 1 2.828 0L21 15"/><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8" cy="9" r="1.5"/></svg>
                <span style="font-size:13px;">Добавить фото</span>
              </span>
              <input id="photo-input" type="file" accept="image/*" style="display:none" onchange="onPhotoChange(event)" />
            </label>

            <div class="field"><span>Название вещи</span><input id="f-title" placeholder="Например, синий рюкзак" /></div>
            <div class="field"><span>Место потери</span><input id="f-location" placeholder="Где вы потеряли вещь" /></div>
            <div class="row-2">
              <div class="field"><span>Дата</span><input id="f-date" type="date" value="${today}" /></div>
              <div class="field"><span>Категория</span><select id="f-category">${catOptions}</select></div>
            </div>
            <div class="field"><span>Описание</span><textarea id="f-description" rows="3" placeholder="Приметы, цвет, содержимое..."></textarea></div>
            <button class="submit-btn" id="submit-btn" onclick="submitItem()">Разместить объявление</button>
          </div>
        </div>
      </div>
    `;
    document.getElementById('f-title').addEventListener('input', updateSubmitState);
    document.getElementById('f-location').addEventListener('input', updateSubmitState);
    updateSubmitState();
  }

  function updateSubmitState(){
    const title = document.getElementById('f-title').value.trim();
    const location = document.getElementById('f-location').value.trim();
    document.getElementById('submit-btn').disabled = !(title && location);
  }

  function onPhotoChange(e){
    const file = e.target.files && e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      draftPhoto = reader.result;
      const img = document.getElementById('photo-preview');
      img.src = draftPhoto;
      img.style.display = 'block';
      document.getElementById('photo-placeholder').style.display = 'none';
    };
    reader.readAsDataURL(file);
  }

  function closeModal(){ document.getElementById('modal-root').innerHTML = ''; }

  async function submitItem(){
    const title = document.getElementById('f-title').value.trim();
    const location = document.getElementById('f-location').value.trim();
    if (!title || !location) return;
    const description = document.getElementById('f-description').value.trim() || "Без описания.";
    const date = document.getElementById('f-date').value;
    const category = document.getElementById('f-category').value;
    const id = String(Math.floor(10000 + Math.random() * 89999));
    const reportedBy = currentUser ? `${currentUser.firstName} ${currentUser.lastName}` : null;
    state.items = [{ id, title, description, location, date, category, status:"lost", photo: draftPhoto, reportedBy }, ...state.items];
    closeModal();
    renderAll();
    saveItems(state.items);
    await awardReportPoint();
  }

  async function awardReportPoint(){
    if (!currentUser) return;
    const users = await loadUsers();
    const u = users.find(x => x.id === currentUser.id);
    if (u){
      u.points = (u.points || 0) + 1;
      currentUser.points = u.points;
    } else {
      currentUser.points = (currentUser.points || 0) + 1;
      users.push(currentUser);
    }
    await saveUsers(users);
    await saveMyProfile(currentUser);
    renderWhoAmI();
    if (document.getElementById('page-classes').style.display !== 'none') renderParticipantsLeaderboard();
  }

  bootAuth();
</script>
</body>
</html>
